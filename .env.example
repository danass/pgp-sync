# Deploy-time config for pgp-sync. Copy to `.env` and edit before running
# ./scripts/install.sh — the installer reads these to generate
# /etc/pgp-sync/env (the systemd runtime env) and to print accurate
# follow-up commands.
#
# Anything not set falls back to the defaults below.

# Hostname your TLS cert is issued for. Used in the post-install acme.sh
# command hint and in /etc/pgp-sync/env if you let the installer pick a
# default cert path.
DOMAIN=sync.example.com

# Listening port for the service. Use a high port — the service runs as
# an unprivileged user and can't bind 80/443 without setcap.
PORT=8443

# Where the SQLite database lives. Must be writable by SERVICE_USER.
DATA_DIR=/var/lib/pgp-sync

# Where TLS cert + key get installed by the acme.sh deploy hook.
CERT_DIR=/etc/pgp-sync/certs

# Unix user the service runs as. Created by install.sh if missing.
SERVICE_USER=pgpsync
