# Environment file for pgp-sync, loaded by systemd. Copy to /etc/pgp-sync/env
# and adjust. The actual binary reads only these variables (or the equivalent
# command-line flags).

# Bind address. Use a high port — the service runs as an unprivileged user
# and can't bind to 80/443 without setcap. Put a reverse proxy (caddy, nginx)
# in front if you want privileged ports, or use the built-in TLS below.
PGP_SYNC_ADDR=:8443

# Database path. Must live under a directory writable by the pgpsync user.
PGP_SYNC_DB=/var/lib/pgp-sync/data.db

# Built-in TLS. Point these at the live cert + key. The install script wires
# acme.sh up to deploy renewed certs here and reload the unit.
PGP_SYNC_CERT=/etc/pgp-sync/certs/fullchain.pem
PGP_SYNC_KEY=/etc/pgp-sync/certs/privkey.pem
